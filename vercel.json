{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @sorriso/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [{ "source": "/((?!sw\\.js|workbox-.*|manifest\\.webmanifest|brand/|pwa/|ilustracoes/|mascote/|assets/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
